---
import BaseLayout from "./BaseLayout.astro";
import type { ShardProject } from "../lib/shard-projects";

interface Props {
  project: ShardProject;
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.name} — ${project.tagline}`}
  description={project.description}
  image={`${Astro.site}og/projects.png`}
>
  <article class="pb-12 md:pb-16">
    <header class="border-b border-border pb-8 md:pb-10">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3 text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
        <a href="/projects" class="transition-colors hover:text-foreground">← projects</a>
        <span class="flex items-center gap-2">
          <span class={`h-1.5 w-1.5 ${project.status === "Live" ? "bg-primary" : "bg-muted-foreground"}`}></span>
          {project.status}
        </span>
      </div>
      <p class="mb-3 text-xs uppercase tracking-[0.18em] text-primary">/projects/{project.name.toLowerCase()}</p>
      <h1 class="max-w-3xl text-4xl font-bold leading-none tracking-[-0.05em] text-foreground md:text-6xl">
        {project.name}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg">
        {project.tagline}
      </p>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a href={project.github} target="_blank" rel="noopener noreferrer" class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-primary">
          GitHub ↗
        </a>
        {project.demo && (
          <a href={project.demo} target="_blank" rel="noopener noreferrer" class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-primary">
            Live demo ↗
          </a>
        )}
      </div>
    </header>

    <section class="grid gap-4 border-b border-border py-8 md:grid-cols-[10rem_1fr] md:gap-10 md:py-10" aria-labelledby="project-about">
      <h2 id="project-about" class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">About</h2>
      <p class="max-w-2xl text-sm leading-7 text-muted-foreground">{project.description}</p>
    </section>

    <section class="grid gap-5 border-b border-border py-8 md:grid-cols-[10rem_1fr] md:gap-10 md:py-10" aria-labelledby="project-features">
      <h2 id="project-features" class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Features</h2>
      <ol class="divide-y divide-border border-t border-border">
        {project.features.map((feature, index) => (
          <li class="grid grid-cols-[2.25rem_1fr] gap-3 py-4 text-sm leading-relaxed text-foreground/90">
            <span class="text-xs text-muted-foreground">{String(index + 1).padStart(2, "0")}</span>
            <span>{feature}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid gap-5 border-b border-border py-8 md:grid-cols-[10rem_1fr] md:gap-10 md:py-10" aria-labelledby="project-stack">
      <h2 id="project-stack" class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Stack</h2>
      <ul class="grid grid-cols-2 border-t border-border sm:grid-cols-3" role="list">
        {project.tech.map((technology) => (
          <li class="border-b border-border py-3 pr-4 text-xs text-muted-foreground">{technology}</li>
        ))}
      </ul>
    </section>

    <div class="py-10 md:py-14">
      <slot />
    </div>

    <footer class="flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6 text-sm">
      <a href="/projects" class="text-muted-foreground transition-colors hover:text-foreground">← All projects</a>
      <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-primary transition-colors hover:text-foreground">
        {project.name} on GitHub ↗
      </a>
    </footer>
  </article>
</BaseLayout>
