---
import Icon from './Icon.astro';
import { slugify } from '../lib/slugify';

interface Props {
  name: string;
  description: string;
  tech: string[];
  github?: string;
  href?: string;
  pathPrefix: string;
}

const { name, description, tech, github, href, pathPrefix } = Astro.props;
const isExternal = href?.startsWith('http');
---

<article class="project-row">
  <div class="project-path">{pathPrefix}{slugify(name)}</div>
  <div class="project-body">
    {href ? (
      <h3><a href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener' : undefined}>{name}</a></h3>
    ) : <h3>{name}</h3>}
    <p>{description}</p>
    {tech.length > 0 && <ul aria-label={`${name} technologies`}>{tech.map((item) => <li>{item}</li>)}</ul>}
  </div>
  <div class="project-actions">
    {href && <a href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener' : undefined} aria-label={`View ${name}`}>{isExternal ? 'Visit ↗' : 'Details →'}</a>}
    {github && <a href={github} target="_blank" rel="noopener noreferrer" aria-label={`${name} source on GitHub`}><Icon name="github" class="size-4" /><span>Source</span></a>}
  </div>
</article>

<style>
  .project-row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) auto; gap: 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--border); }
  .project-row:last-child { border-bottom: 1px solid var(--border); }
  .project-path { color: var(--muted-foreground); font-size: .62rem; overflow-wrap: anywhere; }
  .project-body h3 { margin: 0; font-size: 1rem; }
  .project-body h3 a { color: inherit; text-decoration: none; }
  .project-body h3 a:hover { color: var(--primary-text, var(--primary)); }
  .project-body p { margin: .5rem 0 .8rem; color: var(--muted-foreground); font-size: .78rem; line-height: 1.65; }
  .project-body ul { display: flex; flex-wrap: wrap; gap: .35rem .8rem; margin: 0; padding: 0; list-style: none; color: var(--muted-foreground); font-size: .64rem; }
  .project-body li:not(:last-child)::after { content: ' /'; color: var(--border); }
  .project-actions { display: flex; flex-direction: column; align-items: flex-end; gap: .65rem; }
  .project-actions a { display: inline-flex; align-items: center; gap: .35rem; color: var(--muted-foreground); font-size: .67rem; text-decoration: none; }
  .project-actions a:hover { color: var(--primary-text, var(--primary)); }
  @media (max-width: 640px) { .project-row { grid-template-columns: 1fr auto; gap: .75rem 1rem; } .project-path { grid-column: 1 / -1; } .project-actions span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); } }
</style>
