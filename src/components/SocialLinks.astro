---
import { SITE, SOCIAL } from '../lib/site';
const links = [
  { href: SOCIAL.github, label: 'GitHub', external: true },
  { href: SOCIAL.linkedin, label: 'LinkedIn', external: true },
  { href: SOCIAL.medium, label: 'Medium', external: true },
  { href: SOCIAL.thm, label: 'TryHackMe', external: true },
  { href: SOCIAL.rss, label: 'RSS', external: false },
  { href: SOCIAL.email, label: SITE.email, external: false },
];
---

<ul class="social-links" aria-label="Contact and social links">
  {links.map((link) => (
    <li><a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}><span>{link.label}</span><span aria-hidden="true">{link.external ? '↗' : '→'}</span></a></li>
  ))}
</ul>

<style>
  .social-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--border); }
  .social-links li { border-bottom: 1px solid var(--border); }
  .social-links li:nth-child(odd) { margin-right: 1rem; }
  .social-links a { display: flex; justify-content: space-between; gap: .75rem; padding: .7rem 0; color: var(--muted-foreground); font-size: .68rem; line-height: 1.4; text-decoration: none; overflow-wrap: anywhere; }
  .social-links a:hover { color: var(--primary-text, var(--primary)); }
  @media (max-width: 420px) { .social-links { grid-template-columns: 1fr; } .social-links li:nth-child(odd) { margin-right: 0; } }
</style>
