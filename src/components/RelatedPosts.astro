---
import { getPostSlug, type Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="related" aria-labelledby="related-heading">
    <h2 id="related-heading">Related posts</h2>
    <ul>
      {posts.map((post) => (
        <li><a href={`/blog/${getPostSlug(post)}`}><span>{post.data.title}</span><span aria-hidden="true">↗</span></a></li>
      ))}
    </ul>
  </section>
)}

<style>
  .related { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .related h2 { margin: 0 0 .6rem; color: var(--muted-foreground); font-size: .68rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
  .related ul { margin: 0; padding: 0; list-style: none; }
  .related li { border-bottom: 1px solid var(--border); }
  .related a { display: flex; justify-content: space-between; gap: 1rem; padding: .9rem 0; color: var(--foreground); font-size: .8rem; line-height: 1.5; text-decoration: none; }
  .related a span:last-child { color: var(--muted-foreground); }
  .related a:hover { color: var(--primary-text, var(--primary)); }
</style>
