---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; }
const { headings } = Astro.props;
function clean(text: string): string {
  return text.replace(/[\u{1F000}-\u{1FAFF}\u{2600}-\u{27BF}\u{2190}-\u{21FF}\u{2B00}-\u{2BFF}\u{FE00}-\u{FE0F}\u{200D}\u{2122}\u{2139}\u{2328}\u{23CF}\u{23E9}-\u{23FA}\u{24C2}\u{25AA}-\u{25FE}]/gu, '').replace(/\s+/g, ' ').replace(/^[\s:·•—–-]+|[\s:·•—–-]+$/g, '').trim();
}
const items = headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ ...h, label: clean(h.text) })).filter((h) => h.label);
const show = items.length >= 3;
---

{show && (
  <details class="toc" open>
    <summary><span>Contents</span><span class="indicator" aria-hidden="true">+</span></summary>
    <nav aria-label="Table of contents">
      <ol>
        {items.map((heading, index) => (
          <li class:list={{ nested: heading.depth === 3 }}>
            <a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, '0')}</span><span>{heading.label}</span></a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}

<style>
  .toc { margin-bottom: 2.5rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  summary { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; cursor: pointer; list-style: none; color: var(--muted-foreground); font-size: .67rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
  summary::-webkit-details-marker { display: none; }
  .indicator { font-size: .9rem; transition: transform .15s ease; }
  details[open] .indicator { transform: rotate(45deg); }
  ol { margin: 0; padding: 0 0 .75rem; list-style: none; }
  li a { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .7rem; padding: .35rem 0; color: var(--muted-foreground); font-size: .75rem; line-height: 1.45; text-decoration: none; }
  li.nested a { padding-left: 1rem; font-size: .7rem; }
  li a span:first-child { opacity: .6; font-size: .62rem; }
  li a:hover { color: var(--primary-text, var(--primary)); }
</style>
