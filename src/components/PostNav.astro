---
import { getPostSlug, type Post } from '../lib/posts';
interface Props { prev?: Post | null; next?: Post | null; }
const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="post-nav" aria-label="Post navigation">
    {prev && <a href={`/blog/${getPostSlug(prev)}`} rel="prev"><small>← Previous</small><span>{prev.data.title}</span></a>}
    {next && <a href={`/blog/${getPostSlug(next)}`} rel="next"><small>Next →</small><span>{next.data.title}</span></a>}
  </nav>
)}

<style>
  .post-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .post-nav a { display: flex; flex-direction: column; gap: .45rem; color: var(--foreground); text-decoration: none; }
  .post-nav a:last-child { grid-column: 2; text-align: right; align-items: flex-end; }
  .post-nav small { color: var(--muted-foreground); font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; }
  .post-nav span { max-width: 28ch; font-size: .78rem; line-height: 1.5; }
  .post-nav a:hover span { color: var(--primary-text, var(--primary)); }
  @media (max-width: 480px) { .post-nav { grid-template-columns: 1fr; gap: 1.5rem; } .post-nav a:last-child { grid-column: 1; text-align: left; align-items: flex-start; } }
</style>
