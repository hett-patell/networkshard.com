---
import { getPostSlug, type Post } from '../lib/posts';
import { computeReadTime } from '../lib/readTime';

interface Props {
  posts: Post[];
  variant?: 'compact' | 'detailed';
}
const { posts, variant = 'compact' } = Astro.props;
---

<ol>
  {posts.map((post) => {
    const readTime = computeReadTime(post.body ?? '', post.data.readTime);
    return (
      <li>
        <a href={`/blog/${getPostSlug(post)}`}>
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
          <span class="post-copy">
            <strong>{post.data.title}</strong>
            {variant === 'detailed' && post.data.description && <span>{post.data.description}</span>}
          </span>
          <small>{readTime}</small>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--border); }
  li { border-bottom: 1px solid var(--border); }
  a { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) auto 1rem; gap: 1rem; align-items: start; padding: 1rem 0; color: inherit; text-decoration: none; }
  time, small { color: var(--muted-foreground); font-size: .65rem; }
  .post-copy { display: flex; flex-direction: column; gap: .35rem; }
  strong { font-size: .82rem; line-height: 1.5; }
  .post-copy > span { color: var(--muted-foreground); font-size: .74rem; line-height: 1.55; }
  .arrow { color: var(--muted-foreground); font-size: .75rem; }
  a:hover strong, a:hover .arrow { color: var(--primary-text, var(--primary)); }
  @media (max-width: 560px) {
    a { grid-template-columns: 3rem minmax(0, 1fr) auto; gap: .6rem; padding: .85rem 0; }
    time { padding-top: .1rem; font-size: .6rem; letter-spacing: .04em; text-transform: uppercase; }
    strong { line-height: 1.4; }
    small { display: none; }
    .arrow { grid-column: 3; }
  }
</style>
