---
import BaseLayout from "../layouts/BaseLayout.astro";

type ProjectItem = {
  name: string;
  description: string;
  tech: string[];
  github?: string;
  href?: string;
};

const projects: ProjectItem[] = [
  {
    name: "ShardC2",
    description: "Policy-aware command-and-control framework for authorized red team operations. Go server/agent core with an operator dashboard, RBAC, audit logs, encrypted payloads, and built-in safety controls.",
    tech: ["Go", "PostgreSQL", "Redis", "WebSocket", "Docker"],
    github: "https://github.com/hett-patell/ShardC2",
    href: "/shardc2",
  },
  {
    name: "ShardLure",
    description: "SSH honeypot that clusters bots by HASSH and username playbook instead of IP. Cowrie + journal ingest, intent classification, live globe dashboard, stealth persona with bait files, and STIX 2.1 IOC export.",
    tech: ["Go", "Python", "SQLite", "Cowrie", "HASSH", "STIX"],
    github: "https://github.com/hett-patell/ShardLure",
    href: "/shardlure",
  },
  {
    name: "ShardFlow",
    description: "Layer-2 LAN workbench for authorized lab use. Discovers every device on the wire (ARP, mDNS, SSDP, OUI) and applies per-target drop, throttle, or silent pcap policies via nftables, tc/IFB, and AF_PACKET ARP poisoning. TUI + JSON-RPC CLI.",
    tech: ["Go", "Linux", "nftables", "libpcap", "AF_PACKET", "JSON-RPC"],
    github: "https://github.com/hett-patell/ShardFlow",
    href: "/shardflow",
  },
  {
    name: "ShardPass",
    description: "Local-first Chrome MV3 TOTP authenticator with inline autofill, an encrypted local vault, QR / otpauth import, and per-domain account matching for 2FA-heavy workflows.",
    tech: ["TypeScript", "React", "Tailwind", "Vite", "Chrome MV3"],
    github: "https://github.com/hett-patell/ShardPass",
    href: "/shardpass",
  },
  {
    name: "ShardTune",
    description: "Spotify controller & listening analytics for Chromium. Now Playing with album art, waveform viz, analytics dashboard, friend activity, and Vibe Sync — all computed locally with BYO Client ID.",
    tech: ["TypeScript", "React", "Tailwind", "Vite", "Chrome MV3"],
    github: "https://github.com/hett-patell/ShardTune",
    href: "/shardtune",
  },
  {
    name: "SSH Attack Telemetry",
    description: "Live globe visualising 30 days of SSH brute-force attempts against my exposed Oracle Cloud VM — 1,595 attempts, 64 unique IPs, 20+ countries, all bounced off pubkey-only auth.",
    tech: ["Astro", "Three.js", "globe.gl", "Python", "journalctl"],
    href: "/ssh-attacks/",
  },
  {
    name: "VulnInsights",
    description: "Vulnerability tracking dashboard for security assessments and penetration testing workflows, with status tracking, severity scoring, and finding-level notes.",
    tech: ["TypeScript", "JavaScript", "CSS"],
    github: "https://github.com/hett-patell/vulninsights",
  },
  {
    name: "Cinemax",
    description: "Full-stack movie booking and theatre management platform with a customer-facing frontend and an admin panel for shows, seats, and bookings.",
    tech: ["PHP", "JavaScript", "MySQL", "HTML", "CSS"],
    github: "https://github.com/hett-patell/cinemax",
  },
  {
    name: "QuickMeds",
    description: "Medicine lookup and pharmacy management app for fast inventory search, stock tracking, and over-the-counter prescription handling.",
    tech: ["JavaScript", "HTML", "CSS"],
    github: "https://github.com/hett-patell/QuickMeds",
  },
  {
    name: "Table No 21",
    description: "Restaurant point-of-sale system for streamlined order entry, billing, and live table tracking across dine-in and takeaway flows.",
    tech: ["PHP", "JavaScript", "MySQL", "HTML", "CSS"],
  },
];

const tools: ProjectItem[] = [
  {
    name: "ShardShell",
    description: "Refined PHP post-exploitation shell for authorized red team engagements, with separate Linux and Windows variants tuned to OS-native recon, priv-esc, and log-clearing. Ships with a Python build-time obfuscator and self-decrypting loader for AV evasion.",
    tech: ["PHP", "Python", "Linux", "Windows"],
    github: "https://github.com/hett-patell/ShardShell",
    href: "/shardshell",
  },
  {
    name: "ShardPet",
    description: "Chromium MV3 extension that drops 1-3 animated Gen 5 Pokemon onto every page, with a per-hostname productivity nag that triggers a fullscreen 'get back to work' overlay. Shadow-DOM isolated, GPU-only animation, offline after first sprite cache.",
    tech: ["TypeScript", "Vite", "Vitest", "Chrome MV3", "Shadow DOM"],
    github: "https://github.com/hett-patell/ShardPet",
    href: "/shardpet",
  },
];
---

<BaseLayout
  title="Projects — Security Tools & Web Applications"
  description="Cybersecurity tools and web applications built by Het Patel — including vulnerability tracking dashboards and full-stack platforms."
  image={`${Astro.site}og/projects.png`}
>
  <header class="border-b border-border pb-8 md:pb-10">
    <p class="mb-3 text-xs uppercase tracking-[0.18em] text-primary">/projects</p>
    <div class="grid gap-4 md:grid-cols-[1fr_15rem] md:items-end">
      <h1 class="text-4xl font-bold tracking-[-0.05em] text-foreground md:text-6xl">Selected work</h1>
      <p class="text-sm leading-6 text-muted-foreground">Security systems, local-first utilities, and practical software built to be inspected.</p>
    </div>
  </header>

  <section class="py-8 md:py-10" aria-labelledby="projects-heading">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <h2 id="projects-heading" class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Projects</h2>
      <span class="text-xs text-muted-foreground">{String(projects.length).padStart(2, "0")}</span>
    </div>
    <ol class="border-t border-border">
      {projects.map((project, index) => (
        <li class="border-b border-border">
          <article class="grid gap-3 py-5 md:grid-cols-[2.25rem_13rem_minmax(0,1fr)] md:gap-5">
            <span class="text-[11px] text-muted-foreground">{String(index + 1).padStart(2, "0")}</span>
            <div>
              {project.href ? (
                <a href={project.href} class="font-semibold text-foreground underline decoration-transparent underline-offset-4 transition-colors hover:text-primary hover:decoration-primary">{project.name}</a>
              ) : (
                <h3 class="font-semibold text-foreground">{project.name}</h3>
              )}
              <p class="project-tech mt-2 text-[11px] leading-5 text-muted-foreground">{project.tech.join(" · ")}</p>
            </div>
            <div>
              <p class="text-sm leading-6 text-muted-foreground">{project.description}</p>
              <div class="mt-3 flex gap-5 text-xs">
                {project.href && <a href={project.href} class="text-primary transition-colors hover:text-foreground">Details →</a>}
                {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-muted-foreground transition-colors hover:text-foreground">Source ↗</a>}
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>

  <section class="border-t border-border py-8 md:py-10" aria-labelledby="tools-heading">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <div>
        <h2 id="tools-heading" class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Small tools</h2>
        <p class="mt-2 text-sm text-muted-foreground">Focused security utilities and experiments.</p>
      </div>
      <span class="text-xs text-muted-foreground">{String(tools.length).padStart(2, "0")}</span>
    </div>
    <ol class="border-t border-border">
      {tools.map((tool, index) => (
        <li class="border-b border-border">
          <article class="grid gap-3 py-5 md:grid-cols-[2.25rem_13rem_minmax(0,1fr)] md:gap-5">
            <span class="text-[11px] text-muted-foreground">{String(index + 1).padStart(2, "0")}</span>
            <div>
              {tool.href ? <a href={tool.href} class="font-semibold text-foreground transition-colors hover:text-primary">{tool.name}</a> : <h3 class="font-semibold text-foreground">{tool.name}</h3>}
              <p class="project-tech mt-2 text-[11px] leading-5 text-muted-foreground">{tool.tech.join(" · ")}</p>
            </div>
            <div>
              <p class="text-sm leading-6 text-muted-foreground">{tool.description}</p>
              <div class="mt-3 flex gap-5 text-xs">
                {tool.href && <a href={tool.href} class="text-primary transition-colors hover:text-foreground">Details →</a>}
                {tool.github && <a href={tool.github} target="_blank" rel="noopener noreferrer" class="text-muted-foreground transition-colors hover:text-foreground">Source ↗</a>}
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .project-tech {
    text-align: left;
    text-align-last: left;
    text-wrap: wrap;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }
</style>
