---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { CATEGORIES, type CategoryId } from '../../lib/taxonomy';
import PostList from '../../components/PostList.astro';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  return CATEGORIES.filter((category) => allPosts.some((post) => post.data.category === category.id))
    .map((category) => ({ params: { category: category.id }, props: { category, allPosts } }));
}

const { category, allPosts } = Astro.props;
const posts = allPosts.filter((post) => post.data.category === (category.id as CategoryId));
---

	<BaseLayout title={`Category: ${category.label}`} description={category.description} image={`${Astro.site}og/categories/${category.id}.png`}>
  <section class="pb-12">
    <header class="mb-8 border-b border-border pb-8 md:pb-10">
      <a href="/categories" class="text-xs text-muted-foreground transition-colors hover:text-foreground">← archive index</a>
      <p class="mb-3 mt-6 text-xs uppercase tracking-[0.18em] text-primary">/categories/{category.id}</p>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-4xl font-bold tracking-[-0.05em] text-foreground md:text-6xl">{category.label}</h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">{category.description}</p>
        </div>
        <p class="text-xs text-muted-foreground">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      </div>
    </header>
    <PostList posts={posts} variant="detailed" />
  </section>
</BaseLayout>
