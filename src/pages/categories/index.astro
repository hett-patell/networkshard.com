---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { CATEGORIES } from '../../lib/taxonomy';

const posts = await getPublishedPosts();
const categories = CATEGORIES.map((category) => ({
  ...category,
  count: posts.filter((post) => post.data.category === category.id).length,
})).filter((category) => category.count > 0);
---

	<BaseLayout title="Categories" description="Browse posts by category." image={`${Astro.site}og/categories.png`}>
  <section class="pb-12">
    <header class="border-b border-border pb-8 md:pb-10">
      <p class="mb-3 text-xs uppercase tracking-[0.18em] text-primary">/categories</p>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h1 class="text-4xl font-bold tracking-[-0.05em] text-foreground md:text-6xl">Archive index</h1>
          <p class="mt-3 text-sm text-muted-foreground">Posts filed by their primary category.</p>
        </div>
        <span class="text-xs text-muted-foreground">{categories.length} categories</span>
      </div>
    </header>

    <ol class="border-b border-border" role="list">
      {categories.map((category, index) => (
        <li>
          <a href={category.href} class="group grid gap-3 border-t border-border py-5 sm:grid-cols-[2.5rem_13rem_1fr_auto] sm:items-center">
            <span class="text-[11px] text-muted-foreground">{String(index + 1).padStart(2, '0')}</span>
            <h2 class="font-semibold text-foreground transition-colors group-hover:text-primary">{category.label}</h2>
            <p class="text-sm leading-6 text-muted-foreground">{category.description}</p>
            <span class="text-xs text-muted-foreground">{category.count} {category.count === 1 ? 'post' : 'posts'} →</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
