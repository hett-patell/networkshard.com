---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../../lib/posts';
import { slugify } from '../../../lib/slugify';
import PostList from '../../../components/PostList.astro';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const slugs = new Set<string>();
  for (const post of allPosts) {
    for (const tag of post.data.tags || []) slugs.add(slugify(tag));
  }
  return [...slugs].map((tag) => ({ params: { tag }, props: { allPosts } }));
}

const { tag } = Astro.params;
const allPosts = (Astro.props.allPosts || await getPublishedPosts()) as Awaited<ReturnType<typeof getPublishedPosts>>;
const posts = allPosts.filter((post) => (post.data.tags || []).some((item) => slugify(item) === tag));
const label = posts.flatMap((post) => post.data.tags || []).find((item) => slugify(item) === tag) || (tag || 'tag').replace(/-/g, ' ');
---

	<BaseLayout title={`${label} — Blog`} description={`Articles tagged "${label}" — cybersecurity, penetration testing, and security research.`} image={`${Astro.site}og/tags/${tag}.png`}>
  <section class="pb-12">
    <header class="mb-8 border-b border-border pb-8 md:pb-10">
      <a href="/blog/tags" class="text-xs text-muted-foreground transition-colors hover:text-foreground">← all topics</a>
      <p class="mb-3 mt-6 text-xs uppercase tracking-[0.18em] text-primary">/blog/tags/{tag}</p>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h1 class="text-4xl font-bold tracking-[-0.05em] text-foreground md:text-6xl">{label}</h1>
        <p class="text-xs text-muted-foreground">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
      </div>
    </header>
    <PostList posts={posts} variant="detailed" />
  </section>
</BaseLayout>
