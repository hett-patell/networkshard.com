---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../../lib/posts';
import { slugify } from '../../../lib/slugify';

const posts = await getPublishedPosts();
const tagMap = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags || []) {
    const slug = slugify(tag);
    const current = tagMap.get(slug);
    if (current) current.count += 1;
    else tagMap.set(slug, { label: tag, count: 1 });
  }
}
const sortedTags = [...tagMap.entries()].sort((a, b) => b[1].count - a[1].count);
---

	<BaseLayout title="Tags — Blog" description="Browse cybersecurity articles by topic and category." image={`${Astro.site}og/tags.png`}>
  <section class="pb-12">
    <header class="border-b border-border pb-8 md:pb-10">
      <p class="mb-3 text-xs uppercase tracking-[0.18em] text-primary">/blog/tags</p>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h1 class="text-4xl font-bold tracking-[-0.05em] text-foreground md:text-6xl">Topics</h1>
          <p class="mt-3 text-sm text-muted-foreground">Browse articles by subject.</p>
        </div>
        <span class="text-xs text-muted-foreground">{String(sortedTags.length).padStart(2, '0')} total</span>
      </div>
    </header>

    <ol class="border-b border-border" role="list">
      {sortedTags.map(([slug, { label, count }], index) => (
        <li>
          <a href={`/blog/tags/${slug}`} class="group grid grid-cols-[2.5rem_1fr_auto] items-center gap-3 border-t border-border py-4 text-sm">
            <span class="text-[11px] text-muted-foreground">{String(index + 1).padStart(2, '0')}</span>
            <span class="font-semibold text-foreground transition-colors group-hover:text-primary">{label}</span>
            <span class="text-xs text-muted-foreground">{count} {count === 1 ? 'post' : 'posts'} →</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
